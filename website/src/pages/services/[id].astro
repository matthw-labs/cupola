---
// One page per service: what Cupola does with it (the README's row), how to
// connect it (the app's own registry: port, where the credential lives, the
// caveat Settings shows first), how far it has been tested, and its
// neighbours. Everything is read from the repository, so a page says what the
// app says. No phone here: its screens are the same on every page, and
// nineteen pages sharing them would read as one page nineteen times.
import type { GetStaticPaths } from 'astro';
import Guide from '../../layouts/Guide.astro';
import { services, glyph, type Service } from '../../lib/repo';
import { registryOf } from '../../lib/registry';
import { servicePages, type PageId } from '../../data/pages';
import { pick } from '../../data/faq';
import type { Qa } from '../../lib/seo';
import { site } from '../../config';

export const getStaticPaths: GetStaticPaths = () => services().map((s) => ({ params: { id: s.id }, props: { service: s } }));

const { service: s } = Astro.props as { service: Service };
const page = servicePages.find((p) => p.path === `/services/${s.id}/`)!;
const reg = registryOf(s.name);

const escape = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// The registry marks a config key with backticks, as the settings screen does.
const html = (t: string) => escape(t).replace(/`([^`]+)`/g, '<code>$1</code>');

const aka = s.aka ? s.aka.replace(/\s*\/\s*/g, ' and ') : undefined;
const does = s.what
  .split(/;\s+|\.\s+/)
  .map((x) => x.trim().replace(/\.$/, ''))
  .filter(Boolean)
  .map((x) => x[0].toUpperCase() + x.slice(1));

const address = reg.defaultPort === 443 ? 'https://192.168.1.20' : `http://192.168.1.20:${reg.defaultPort}`;
const webLogin = reg.credentialPath === null;

const tested = {
  verified: `Verified end to end: Cupola's screens and actions have run against a real ${s.name}.`,
  partial: `Partly verified: Cupola's screens have read a real ${s.name}, but its actions have not been tried on one yet.`,
  untested: `Tested against recorded answers from ${s.name}'s API, not yet on a running server.`,
}[s.tested];

const home: PageId =
  s.category === 'Media' ? (s.id === 'seerr' ? 'seerr' : 'arr') : s.category === 'Downloads' ? 'downloads' : s.category === 'Stream' ? 'stream' : 'homelab';
const neighbours = services().filter((x) => x.category === s.category && x.id !== s.id);

const d = site.downloads;
const availability = d.apk
  ? 'It is a public TestFlight beta on iPhone, iPad and Mac, and an APK on Android.'
  : d.testflight
    ? 'It is a public TestFlight beta on iPhone, iPad and Mac today; Android comes with the first GitHub release.'
    : 'It is not open to download yet.';

const questions: Qa[] = [
  {
    id: 'app',
    q: `Is there a ${s.name} app for iPhone and Android?`,
    a: `Yes: Cupola, free and open source, connects to ${s.name} directly. ${availability} See <a href="/install/">install</a>.`,
  },
  webLogin
    ? {
        id: 'login',
        q: `What does Cupola sign in to ${s.name} with?`,
        a: `${escape(s.auth)}: the same login as its web interface. Cupola keeps it in your device's secure storage.`,
      }
    : {
        id: 'key',
        q: `Where do I find the ${s.name} ${s.id === 'plex' ? 'token' : 'API key'}?`,
        a: `In ${s.name}'s own web interface: <strong>${escape(reg.credentialPath!)}</strong>.`,
      },
  ...pick('away', 'certs'),
];
---
<Guide
  page={page}
  parent="services"
  lede={`Cupola is a free, open-source app for ${s.name}${aka ? ` (${aka} too)` : ''} on iPhone, iPad, Android and Mac. It connects straight to your own ${s.name}, with no account.`}
  questions={questions}
  related={[home, 'services', 'install']}
>
  <h2>What Cupola does with {s.name}</h2>
  <ul>{does.map((x) => <li>{x}</li>)}</ul>
  <p><strong>Control:</strong> {s.control}. <strong>Signs in with:</strong> {s.auth}.</p>

  <h2>How well it is tested</h2>
  <p>
    {s.note ?? tested}
    {s.tested !== 'verified' && (
      <> If you run {s.name}, <a href={`${site.issues}/new`} rel="noopener">tell us how it goes</a>.</>
    )}
  </p>

  <h2>Connect {s.name}</h2>
  {reg.setupNote && <p><strong>Before you start.</strong> <span set:html={html(reg.setupNote)} /></p>}
  <ol>
    <li>
      <strong>Its address</strong>{reg.defaultPort === 443 ? '' : ', with the port'}: <code>{address}</code> by default, or your reverse proxy's address. <a href="/faq/#address">More on addresses</a>.
    </li>
    {webLogin ? (
      <li><strong>{s.auth}</strong>: the same login as its web interface.</li>
    ) : (
      <li>
        <strong>{s.id === 'plex' ? 'The token' : 'The API key'}</strong>, in {s.name}'s web interface: <strong>{reg.credentialPath}</strong>.
      </li>
    )}
    <li>
      <strong>Test it before you save.</strong> If it fails, Cupola tells you why.
    </li>
  </ol>
  <p>
    Away from home, Cupola uses your VPN or reverse proxy: <a href="/faq/#away">how that works</a>.
  </p>

  <h2>Also in {s.category}</h2>
  <ul class="also not-prose">
    {neighbours.map((x) => (
      <li>
        <a href={`/services/${x.id}/`}><span class="g" set:html={glyph(x.id)} />{x.name}</a>
      </li>
    ))}
  </ul>
</Guide>

<style>
  ol {
    padding-left: 1.3em;
  }
  ol li + li {
    margin-top: 0.6em;
  }
  .also {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
  }
  .also a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--hair);
    color: var(--ink);
    text-decoration: none;
  }
  .also a:hover {
    border-color: color-mix(in srgb, var(--light) 50%, transparent);
  }
  .also .g {
    display: inline-flex;
    width: 18px;
    height: 18px;
    color: var(--ink-2);
  }
</style>
