---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
import Phone from '../components/Phone.astro';
import Desktop from '../components/Desktop.astro';
import ServiceRing from '../components/ServiceRing.astro';
import Reach from '../components/Reach.astro';
import Get from '../components/Get.astro';
import Faq from '../components/Faq.astro';
import { site } from '../config';
import { lit, still } from '../data/titles';
import { services, stars } from '../lib/repo';
import { softwareApplication, sourceCode, website, faqPage } from '../lib/seo';
import { pick } from '../data/faq';
import { pages } from '../data/pages';

const all = services();
const verified = all.filter((s) => s.tested === 'verified').length;
const helpWanted = all.filter((s) => s.tested !== 'verified');
const count = await stars();
const questions = pick('arrApp', 'account', 'away', 'player', 'household', 'free');

const story = [
  {
    screen: 'home',
    light: 'singslide',
    tab: 'Home',
    title: 'Today, at a glance.',
    body: 'What arrived today, what comes out next, what you were halfway through, and anything that needs you. Arrange it your way.',
  },
  {
    screen: 'discover',
    light: 'sprite',
    tab: 'Discover',
    title: 'Find the next thing to watch.',
    body: 'Trending, a calendar, genres, people and more. One search checks Seerr, Radarr, Sonarr, Jellyfin, Plex and Emby at once, so you know if you already have it.',
  },
  {
    screen: 'title-spring',
    light: 'spring',
    tab: 'A title',
    title: 'Decide on one page.',
    body: 'Ratings, cast, trailer and where it stands on your server. Then one tap: add it to Radarr or Sonarr, request it, or pick a release yourself.',
  },
  {
    screen: 'activity',
    light: 'charge',
    tab: 'Activity',
    title: 'When something breaks, the fix is right there.',
    body: 'A stuck download, files waiting to be imported, a service that stopped answering. Activity says what happened in plain words and offers the fix.',
  },
  {
    screen: 'requests',
    light: 'sintel',
    tab: 'The household',
    title: 'Everyone at home can ask.',
    body: 'Family members sign in to Seerr with their own account. They get a simpler Cupola: what is ready, what they asked for, and when it will arrive.',
  },
] as const;
---
<Base
  title={pages.home.title}
  description={pages.home.description}
  jsonld={[softwareApplication(), sourceCode(), website(), faqPage(questions)]}
>
  <!-- The way in: down through the Cupola, into a room lit by a title. -->
  <section class="descent" data-descent data-light="lamp" aria-labelledby="claim">
    <div class="stage">
      <div class="portal" aria-hidden="true" style={`background-image:url(${still('singopen')})`}></div>
      <div class="dome"><Mark size="100%" eager label="The Cupola mark: the window of a cupola seen from above, with the Earth's light coming through" /></div>
      <div class="copy">
        <h1 id="claim" class="t-giant">{site.claim}</h1>
        <p class="t-lede">
          One app for Radarr, Sonarr, Seerr, your download clients and the server they run on. It talks straight to your own services.
        </p>
        <div class="ctas">
          <a class="btn btn-ink" href="/install/">Get Cupola<Icon name="arrow" /></a>
          <a class="btn btn-ghost" href={site.repo} rel="noopener">
            <Icon name="github" />Star on GitHub{count !== null && <span class="count">{count.toLocaleString('en-US')}</span>}
          </a>
        </div>
        <p class="t-meta facts">Free and open source · iPhone, Android and Mac · No Cupola account</p>
      </div>
      <span class="cue" aria-hidden="true"></span>
    </div>
  </section>

  <!-- The app, as a working model beside what it does. -->
  <section class="story" id="tour" aria-label="A tour of Cupola" data-light-self="(max-width: 860px)">
    <div class="well grid">
      <div class="steps">
        {story.map((s, i) => (
          <article class:list={['step', { active: i === 0 }]} data-screen={s.screen} {...lit(s.light)}>
            <p class="t-micro"><span class="n tabular">{i + 1}/5</span> {s.tab}</p>
            <h2 class="t-room">{s.title}</h2>
            <p class="t-lede">{s.body}</p>
          </article>
        ))}
        <ol class="dots" aria-hidden="true">{story.map((_, i) => <li class:list={{ on: i === 0 }}></li>)}</ol>
      </div>
      <div class="device">
        <div class="sticky">
          <Phone id="tour-phone" width="min(340px, 74vw)" />
          <p class="t-meta hint">Try it: tap the tabs, a poster, a button.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- The stack. -->
  <section class="block stackb" data-light="lamp" aria-labelledby="stack-h">
    <div class="well two">
      <div>
        <h2 id="stack-h" class="t-screen rise">Your whole stack in one app.</h2>
        <p class="t-lede rise" style="--i:1">
          Seerr, the arr apps, four download clients, Jellyfin, Plex, Emby, and the machine underneath. Set up only what you run; the rest stays out of the way.
        </p>
        <ul class="cats rise" style="--i:2">
          {(['Media', 'Downloads', 'Stream', 'Infrastructure'] as const).map((c) => (
            <li>
              <span class="t-micro">{c}</span>
              <span>{all.filter((s) => s.category === c).map((s, i, arr) => (
                <>
                  <a href={`/services/${s.id}/`}>{s.name}</a>{i < arr.length - 1 ? ', ' : ''}
                </>
              ))}</span>
            </li>
          ))}
        </ul>
        <p class="rise honest" style="--i:3">
          <Icon name="check" size={18} />
          <span><b>{verified} of {all.length}</b> verified end to end on real servers. The <a href="/services/">services page</a> shows the rest.</span>
        </p>
      </div>
      <ServiceRing />
    </div>
  </section>

  <!-- Privacy. -->
  <section class="block" data-light="lamp" aria-labelledby="reach-h">
    <div class="well">
      <div class="head">
        <h2 id="reach-h" class="t-screen rise">Your server is the backend.</h2>
        <p class="t-lede rise" style="--i:1">
          Cupola connects straight to your services, at home or through your VPN or reverse proxy. Keys stay on your device. Self-signed certificates are trusted once, then pinned.
        </p>
      </div>
      <div class="rise" style="--i:2"><Reach /></div>
      <p class="more"><a href="/privacy/">How Cupola keeps your keys and data safe<Icon name="arrow" size={16} /></a></p>
    </div>
  </section>

  <!-- Everywhere. -->
  <section class="block" {...lit('tos')} aria-labelledby="every-h">
    <div class="well">
      <div class="head">
        <h2 id="every-h" class="t-screen rise">Made for the phone. At home on a desk.</h2>
        <p class="t-lede rise" style="--i:1">
          Designed for the phone first. On a tablet, a title opens beside its list. On a Mac you get a sidebar, keyboard shortcuts and a command palette. One design on every platform.
        </p>
      </div>
      <div class="rise" style="--i:2"><Desktop /></div>
      <ul class="plats rise" style="--i:3">
        <li><Icon name="apple" /><span><b>iPhone and iPad</b> Widgets, lock screen, Dynamic Type, VoiceOver</span></li>
        <li><Icon name="android" /><span><b>Android</b> Widgets, TalkBack, phones and tablets</span></li>
        <li><Icon name="desktop" /><span><b>Mac</b> Signed and notarized, keyboard first</span></li>
        <li><Icon name="desktop" /><span><b>Windows and Linux</b> Same app, not yet tested on real machines</span></li>
      </ul>
    </div>
  </section>

  <!-- Open source. -->
  <section class="block" data-light="lamp" aria-labelledby="open-h">
    <div class="well two">
      <div>
        <h2 id="open-h" class="t-screen rise">Built in the open.</h2>
        <p class="t-lede rise" style="--i:1">
          All the code is on GitHub under the Apache License 2.0, and the app is free with nothing to unlock. Tests hold it to its design: contrast, touch targets, large text and screen readers.
        </p>
        <div class="ctas rise" style="--i:2">
          <a class="btn btn-ink" href={site.repo} rel="noopener"><Icon name="star" />Star the repository{count !== null && <span class="count">{count.toLocaleString('en-US')}</span>}</a>
          <a class="btn btn-ghost" href="/contribute/">Contribute</a>
        </div>
      </div>
      <div class="help rise" style="--i:3">
        <h3 class="t-section">Run one of these? Help verify it.</h3>
        <p class="t-meta">These follow each service's official API but have not been tested end to end on a real server yet. Tell us how it goes, either way.</p>
        <ul>
          {helpWanted.map((s) => (
            <li>
              <a href={`/services/${s.id}/`}>
                <span>{s.name}</span>
                <span class="mark-t">{s.tested === 'partial' ? '◐ partly verified' : '○ recorded answers only'}</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="btn btn-ghost btn-m" href={`${site.issues}/new`} rel="noopener">Send a report<Icon name="out" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- Questions. -->
  <section class="block" data-light="lamp" aria-labelledby="faq-h">
    <div class="well two faqgrid">
      <div>
        <h2 id="faq-h" class="t-screen rise">Questions people ask first.</h2>
        <p class="more"><a href="/faq/">Every question<Icon name="arrow" size={16} /></a></p>
      </div>
      <Faq items={questions} />
    </div>
  </section>

  <!-- The close: the promise, and the way to get it. -->
  <section class="close" {...lit('singopen')} aria-labelledby="get-h">
    <div class="well">
      <Mark size={72} />
      <div class="head">
        <h2 id="get-h" class="t-screen">Get Cupola</h2>
        <p class="t-meta">{site.promise}</p>
      </div>
      <Get />
    </div>
  </section>
</Base>

<script>
  // The descent: the mark rises to the middle and grows until its round window
  // fills the screen, and the window shows the title instead of the Earth.
  const section = document.querySelector<HTMLElement>('[data-descent]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  if (section && !reduce.matches) {
    section.classList.add('moving');
    const stage = section.querySelector<HTMLElement>('.stage')!;
    const dome = section.querySelector<HTMLElement>('.dome')!;
    let raf = 0;
    let home = { x: 0, y: 0, size: 1 };
    let box = { w: 0, h: 0 };
    const measure = () => {
      dome.style.transform = 'none';
      const r = dome.getBoundingClientRect();
      const s = stage.getBoundingClientRect();
      home = { x: r.left + r.width / 2 - (s.left + s.width / 2), y: r.top + r.height / 2 - (s.top + s.height / 2), size: r.width };
      box = { w: s.width, h: s.height };
      frame();
    };
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const frame = () => {
      raf = 0;
      const top = section.getBoundingClientRect().top;
      const span = section.offsetHeight - window.innerHeight;
      // A window with no height yet (a tab opened in the background) has nothing to scroll.
      const p = span > 0 ? clamp(-top / span) : 0;
      const move = ease(clamp(p / 0.45));
      const zoom = Math.pow(clamp((p - 0.12) / 0.78), 2.2);
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      // The round window is about 15% of the mark's width; grow it past the screen's corners.
      const windowR = home.size * 0.152;
      const target = Math.hypot(vw, vh) / 2 / windowR;
      const scale = 1 + zoom * (target * 1.15 - 1);
      // The mark travels from where the layout put it to the middle of the screen.
      const x = -home.x * move;
      const y = -home.y * move;
      dome.style.transform = `translate(${x}px, ${y}px) scale(${scale})`;
      stage.style.setProperty('--copy', String(1 - clamp(p / 0.22)));
      stage.style.setProperty('--r', `${windowR * scale}px`);
      // The portal's circle follows the window in the stage's own coordinates:
      // the window's size counts a scrollbar and a phone's hidden toolbar, the
      // stage does not.
      stage.style.setProperty('--cx', `${box.w / 2 + home.x + x}px`);
      stage.style.setProperty('--cy', `${box.h / 2 + home.y + y}px`);
      stage.style.setProperty('--portal', String(clamp((p - 0.18) / 0.3)));
      stage.style.setProperty('--arrive', String(clamp((p - 0.72) / 0.18)));
      stage.style.setProperty('--dome', String(1 - clamp((p - 0.62) / 0.2)));
    };
    const ask = () => {
      if (!raf) raf = requestAnimationFrame(frame);
    };
    measure();
    window.addEventListener('scroll', ask, { passive: true });
    // Where the mark sits depends on the words above it, which change height
    // when the fonts arrive: measure again whenever the stage or the words do.
    const resized = new ResizeObserver(measure);
    resized.observe(stage);
    resized.observe(section.querySelector('.copy')!);
    // Grown twentyfold, the drawn mark is redrawn at every size; its bitmap is
    // only stretched. Swap it in once it is decoded, before anyone scrolls far.
    const mark = dome.querySelector('img')!;
    const bitmap = new Image();
    bitmap.src = '/brand/cupola_mark.avif';
    bitmap.decode().then(() => (mark.src = bitmap.src), () => {});
  }

  // The tour. On a wide screen the steps scroll beside a pinned phone and the
  // step in the middle of the screen picks the phone's screen. On a phone the
  // whole tour is pinned: scrolling moves through the steps, and the step's
  // words change in place under the phone instead of sliding over it.
  const phone = document.getElementById('tour-phone');
  const tour = document.getElementById('tour');
  const narrow = matchMedia('(max-width: 860px)');
  if (phone && tour) {
    const steps = Array.from(tour.querySelectorAll<HTMLElement>('.step'));
    const dots = Array.from(tour.querySelectorAll<HTMLElement>('.dots li'));
    let current = -1;
    const pick = (i: number) => {
      if (i === current) return;
      current = i;
      steps.forEach((s, j) => s.classList.toggle('active', j === i));
      dots.forEach((d, j) => d.classList.toggle('on', j === i));
      phone.dispatchEvent(new CustomEvent('cupola:show', { detail: steps[i].dataset.screen }));
      document.dispatchEvent(new CustomEvent('cupola:light', { detail: steps[i] }));
    };
    let raf = 0;
    const onScroll = () => {
      raf = 0;
      if (!narrow.matches) return;
      const r = tour.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      if (span <= 0 || r.top > window.innerHeight || r.bottom < 0) return;
      const p = Math.min(0.999, Math.max(0, -r.top / span));
      pick(Math.floor(p * steps.length));
    };
    window.addEventListener('scroll', () => (raf ||= requestAnimationFrame(onScroll)), { passive: true });
    narrow.addEventListener('change', () => {
      current = -1;
      onScroll();
    });
    onScroll();
  }
  if (phone) {
    const io = new IntersectionObserver(
      (entries) => {
        if (narrow.matches) return;
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const screen = (e.target as HTMLElement).dataset.screen;
          if (screen) phone.dispatchEvent(new CustomEvent('cupola:show', { detail: screen }));
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    document.querySelectorAll('.step').forEach((s) => io.observe(s));
  }
</script>

<style>
  /* ---------- The descent ---------- */
  .descent {
    position: relative;
    height: 100svh;
  }
  .descent:global(.moving) {
    height: 200svh;
  }
  .stage {
    --copy: 1;
    --portal: 0;
    --arrive: 0;
    --dome: 1;
    --r: 0px;
    --cx: 50%;
    --cy: 50%;
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    padding: 96px var(--gutter) clamp(28px, 6vh, 64px);
  }
  .dome {
    position: relative;
    z-index: 1;
    align-self: center;
    --size: min(44vmin, 440px, 38svh);
    width: var(--size);
    aspect-ratio: 1;
    transform-origin: 50% 50%;
    opacity: var(--dome);
    will-change: transform;
  }
  /* The glow under the mark: the drop-shadow it had (30px down, 80px of blur,
     blue at 35%) painted as a gradient, since the filter would blur a surface
     twenty times the mark's size at every step of the descent. The stops follow
     that shadow's falloff, in pixels from the mark's outline (45% of its box),
     which is the same at every size. */
  .dome::before {
    --edge: calc(var(--size) * 0.45);
    content: '';
    position: absolute;
    z-index: -1;
    inset: -120px;
    translate: 0 30px;
    background: radial-gradient(
      circle closest-side,
      rgb(60 123 236 / 0.25) calc(var(--edge) - 90px),
      rgb(60 123 236 / 0.17) calc(var(--edge) - 40px),
      rgb(60 123 236 / 0.135) calc(var(--edge) - 15px),
      rgb(60 123 236 / 0.1) var(--edge),
      rgb(60 123 236 / 0.058) calc(var(--edge) + 25px),
      rgb(60 123 236 / 0.031) calc(var(--edge) + 45px),
      rgb(60 123 236 / 0.012) calc(var(--edge) + 65px),
      rgb(60 123 236 / 0.003) calc(var(--edge) + 85px),
      rgb(60 123 236 / 0) calc(var(--edge) + 105px)
    );
  }
  .portal {
    position: absolute;
    inset: 0;
    z-index: 2;
    background-size: cover;
    background-position: center;
    clip-path: circle(var(--r) at var(--cx) var(--cy));
    opacity: var(--portal);
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent);
    mask-image: linear-gradient(to bottom, #000 62%, transparent);
  }
  .portal::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(10 10 13 / 0.9), rgb(10 10 13 / 0.15) 45%, rgb(10 10 13 / 0) 75%, rgb(10 10 13 / 0.2));
    opacity: var(--arrive);
  }
  .copy {
    position: relative;
    z-index: 3;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 22px;
    opacity: var(--copy);
    transform: translateY(calc((1 - var(--copy)) * -40px));
  }
  .copy h1 {
    max-width: 12ch;
  }
  .copy .t-lede {
    max-width: 30em;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .facts {
    margin-top: -4px;
  }
  .cue {
    position: absolute;
    z-index: 3;
    bottom: 18px;
    left: 50%;
    width: 2px;
    height: 34px;
    margin-left: -1px;
    border-radius: 2px;
    background: linear-gradient(to bottom, transparent, var(--ink-3));
    opacity: calc(var(--copy) * 0.8);
  }
  .descent:not(:global(.moving)) .portal,
  .descent:not(:global(.moving)) .cue {
    display: none;
  }
  @media (min-width: 900px) {
    .copy h1 {
      max-width: none;
    }
  }
  @media (max-aspect-ratio: 4/5) {
    /* A tall screen sees a narrow slice of the skyline: keep the dome in it. */
    .portal {
      background-position: 35% center;
    }
  }
  @media (max-width: 760px) {
    /* Room for the floating tab bar. */
    .stage {
      padding-bottom: calc(100px + env(safe-area-inset-bottom));
      padding-top: 88px;
    }
    .ctas .btn {
      min-width: 220px;
    }
  }

  /* ---------- The tour ---------- */
  .story {
    position: relative;
    padding-top: 6vh;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(32px, 6vw, 96px);
  }
  .steps {
    padding-bottom: 20vh;
  }
  .step {
    min-height: 88vh;
    display: grid;
    align-content: center;
    gap: 16px;
    max-width: 520px;
  }
  .step .n {
    color: var(--ink);
    margin-right: 6px;
  }
  .device {
    position: relative;
  }
  .sticky {
    position: sticky;
    top: calc(50svh - min(340px, 74vw) * 868 / 414 / 2 + 24px);
    display: grid;
    justify-items: center;
    gap: 14px;
  }
  .hint {
    text-align: center;
    max-width: 260px;
  }

  .dots {
    display: none;
  }

  /* On a phone the tour is a pinned stage: the phone above, the step's words
     below, five steps of scrolling to go through them. */
  @media (max-width: 860px) {
    .story {
      --ph: min(210px, 50vw, calc((100svh - 400px) * 414 / 868));
      height: 520svh;
      padding-top: 0;
    }
    .grid {
      position: sticky;
      top: 0;
      height: 100svh;
      display: flex;
      flex-direction: column;
      gap: 18px;
      padding-top: 84px;
      padding-bottom: calc(96px + env(safe-area-inset-bottom));
    }
    .device {
      order: -1;
      flex: none;
      display: flex;
      justify-content: center;
    }
    .sticky {
      position: static;
    }
    .sticky :global(.phone) {
      --w: var(--ph) !important;
    }
    .hint {
      display: none;
    }
    .steps {
      position: relative;
      flex: 1;
      min-height: 0;
      padding: 0;
    }
    .step {
      position: absolute;
      inset: 0 0 auto;
      min-height: 0;
      display: grid;
      align-content: start;
      gap: 10px;
      max-width: none;
      opacity: 0;
      transform: translateY(10px);
      /* The step leaving goes quickly; the next one waits for it, so two
         texts never show on top of each other. */
      transition:
        opacity 120ms ease-out,
        transform 120ms ease-out;
      pointer-events: none;
    }
    .step:global(.active) {
      opacity: 1;
      transform: none;
      pointer-events: auto;
      transition:
        opacity var(--standard) var(--ease) 120ms,
        transform var(--standard) var(--ease) 120ms;
    }
    .step .t-room {
      font-size: 26px;
    }
    .step .t-lede {
      font-size: 16px;
      line-height: 1.5;
    }
    .dots {
      position: absolute;
      top: 3px;
      right: 0;
      display: flex;
      gap: 6px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .dots li {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--fill-strong);
      transition:
        background-color var(--standard) var(--ease),
        width var(--standard) var(--ease);
    }
    .dots li:global(.on) {
      width: 18px;
      border-radius: 3px;
      background: var(--ink);
    }
  }
  @media (max-width: 860px) and (prefers-reduced-motion: reduce) {
    .step {
      transform: none;
    }
  }

  /* ---------- Blocks ---------- */
  .block {
    padding: clamp(96px, 16vh, 180px) 0;
  }
  .head {
    display: grid;
    gap: 20px;
    max-width: 820px;
    margin-bottom: 48px;
  }
  .two {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .two > div:first-child {
