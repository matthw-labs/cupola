---
// A page that answers one need: what Cupola does for a part of the stack,
// with the answer in its first paragraph, the services it touches as the
// README states them, the questions people ask about it, and where to get it.
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import Phone, { type Screen } from '../components/Phone.astro';
import ServiceTable from '../components/ServiceTable.astro';
import Faq from '../components/Faq.astro';
import Get from '../components/Get.astro';
import { site } from '../config';
import { pages, type Page, type PageId } from '../data/pages';
import { lit } from '../data/titles';
import { breadcrumbs, faqPage, softwareApplication, type Qa } from '../lib/seo';

interface Props {
  page: PageId | Page;
  /** The H1, when it should differ from the page's heading. */
  h1?: string;
  lede: string;
  screen?: Screen;
  services?: string[];
  questions?: Qa[];
  related?: (PageId | Page)[];
  get?: boolean;
  /** Draw the questions as a section; the FAQ page draws its own. */
  showQuestions?: boolean;
  /** The page this one sits under in the breadcrumb, such as Services. */
  parent?: PageId;
}
const { page: id, h1, lede, screen, services, questions = [], related = [], get = true, showQuestions = true, parent } = Astro.props;
const page = typeof id === 'string' ? pages[id] : id;
const links = related.map((r) => (typeof r === 'string' ? pages[r] : r));
const up = parent ? pages[parent] : undefined;
const trail = [...(up ? [{ name: up.name, path: up.path }] : []), { name: page.name, path: page.path }];
const jsonld: object[] = [breadcrumbs(trail), softwareApplication()];
if (questions.length) jsonld.push(faqPage(questions));
---
<Base title={page.title} description={page.description} og={page.slug} jsonld={jsonld}>
  <section class:list={['top', { solo: !screen }]} {...lit(page.light)}>
    <div class="well grid">
      <div class="intro">
        <nav class="crumbs t-meta" aria-label="Breadcrumb"><a href="/">Cupola</a> <span aria-hidden="true">/</span> {up && <><a href={up.path}>{up.name}</a> <span aria-hidden="true">/</span> </>}<span aria-current="page">{page.name}</span></nav>
        <h1 class="t-screen">{h1 ?? page.heading}</h1>
        <p class="t-lede" set:html={lede} />
        <div class="ctas">
          <a class="btn btn-ink" href="/install/">Get Cupola<Icon name="arrow" /></a>
          <a class="btn btn-ghost" href={site.repo} rel="noopener"><Icon name="github" />Source on GitHub</a>
        </div>
      </div>
      {screen && (
        <div class="device">
          <Phone show={screen} width="min(320px, 78vw)" />
        </div>
      )}
    </div>
  </section>

  <div class="well body">
    <div class="prose">
      <slot />
    </div>
  </div>

  {services && (
    <section class="well block" aria-labelledby="svc-h">
      <h2 id="svc-h" class="t-room">What Cupola does with each</h2>
      <p class="t-meta sub"><a href="/services/">See all nineteen services</a>.</p>
      <ServiceTable ids={services} />
    </section>
  )}

  {showQuestions && questions.length > 0 && (
    <section class="well block" aria-labelledby="q-h">
      <h2 id="q-h" class="t-room">Questions</h2>
      <Faq items={questions} />
    </section>
  )}

  {get && (
    <section class="well block" aria-labelledby="get-h">
      <h2 id="get-h" class="t-room">Get Cupola</h2>
      <p class="t-meta sub">Free and open source. It works with the services you already run.</p>
      <Get compact />
    </section>
  )}

  {links.length > 0 && (
    <nav class="well block" aria-labelledby="rel-h">
      <h2 id="rel-h" class="t-room">Also in Cupola</h2>
      <ul class="rel">
        {links.map((r) => (
          <li>
            <a href={r.path}>
              <span class="t-section">{r.name}</span>
              <span class="t-meta">{r.heading}</span>
              <Icon name="arrow" size={18} />
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</Base>

<style>
  .top {
    padding: 140px 0 40px;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .solo .grid {
    grid-template-columns: minmax(0, 1fr);
  }
  .intro {
    display: grid;
    gap: 22px;
    max-width: 760px;
  }
  .crumbs a {
    /* A 44px target around a one-line link, without moving the line. */
    display: inline-block;
    padding: 13px 0;
    margin: -13px 0;
    color: var(--ink-2);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--ink);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .body {
    padding-top: 40px;
  }
  .body .prose :global(h2) {
    font-family: var(--display);
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-variation-settings: 'wdth' 88, 'opsz' 38;
  }
  .body .prose :global(h3) {
    font-family: var(--display);
    font-size: 22px;
    font-variation-settings: 'wdth' 94, 'opsz' 22;
  }
  .block {
    padding-top: 96px;
  }
  .block > h2 {
    margin-bottom: 10px;
  }
  .sub {
    margin-bottom: 24px;
  }
  .rel {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .rel a {
    position: relative;
    display: grid;
    gap: 6px;
    height: 100%;
    padding: 22px 52px 22px 22px;
    border-radius: var(--r-door);
    background: rgb(22 22 28 / 0.86);
    border: 1px solid var(--hair);
    text-decoration: none;
    transition: border-color var(--standard) var(--ease);
  }
  .rel a:hover {
    border-color: var(--edge);
  }
  .rel a :global(svg) {
    position: absolute;
    right: 20px;
    top: 24px;
    color: var(--ink-3);
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .device {
      display: flex;
      justify-content: center;
    }
    .rel {
      grid-template-columns: 1fr;
    }
    .top {
      padding-top: 110px;
    }
  }
</style>
