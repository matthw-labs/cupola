<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Cupola</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Cupola</string>
	<key>CupolaAppGroup</key>
	<string>$(CUPOLA_APP_GROUP)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneDelegateClassName</key>
					<string>FlutterSceneDelegate</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<!-- Advertised and browsed for by nothing but the local-network
		     permission probe in AppDelegate. A dedicated type on purpose: it can
		     never collide with a service the user actually runs, so a probe can
		     only ever discover itself. -->
		<string>_cupola-check._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Cupola talks to the services running on your own network: Radarr, Sonarr, Plex, your NAS. Without this, it cannot reach them.</string>
	<!-- Copy from another device scans the other device's code here
	     (mobile_scanner), so a phone reads it without leaving the app. -->
	<key>NSCameraUsageDescription</key>
	<string>Cupola uses the camera only to read the code another device shows when you copy its connections.</string>
	<!-- file_picker links DKImagePickerController, which references the photo
	     library, so App Store Connect refuses a build without this string. Cupola
	     only picks .torrent files through the document picker: the prompt never
	     shows. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Cupola opens only the files you choose to add, such as a .torrent file. It never browses your photos.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.matthwlabs.cupola.outside</string>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Portrait only, deliberately: the collapsing hero, the floating bar's
	     clearance and the poster rails are vertical instruments, and Cupola has
	     no landscape phone layout. See The Portrait Rule in DESIGN.md. The
	     `~ipad` key below is left alone on purpose: an iPad is not a phone. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- The media apps Cupola can hand an item to (the Jellyfin apps and Emby's
	     own): asked with canLaunchUrl before the viewer is offered them. iOS
	     hides a scheme that is not listed here. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>swiftfin</string>
		<string>streamyfin</string>
		<string>fladder</string>
		<string>emby</string>
	</array>
	<!-- An invite to a Seerr opens the app: cupola://invite?… (from the
	     camera reading its QR, or a link tapped where it is a link). Flutter
	     hands the whole link to the router, which reads it
	     (lib/features/discover/domain/seerr_invite.dart). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.matthwlabs.cupola.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cupola</string>
			</array>
		</dict>
	</array>
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
</dict>
</plist>
