  "motion": {
    "$description": "Motion. Every continuous animation stops off screen, in the background and under a screen reader; each one has its Reduce Motion answer.",
    "curve": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0.8,
          0.2,
          1
        ],
        "$description": "The one ease: a fast start and a long settle. Press, state changes, the pager, entrances, flights, progress."
      },
      "sheet-in": {
        "$type": "cubicBezier",
        "$value": [
          0.05,
          0.7,
          0.1,
          1
        ],
        "$description": "Sheets and dialogs arriving."
      },
      "sheet-out": {
        "$type": "cubicBezier",
        "$value": [
          0.3,
          0,
          0.8,
          0.15
        ],
        "$description": "Sheets and dialogs leaving."
      },
      "roll": {
        "$type": "cubicBezier",
        "$value": [
          0.33,
          1,
          0.68,
          1
        ],
        "$description": "A figure rolling into place (easeOutCubic)."
      },
      "ease": {
        "$type": "cubicBezier",
        "$value": [
          0.25,
          0.1,
          0.25,
          1
        ],
        "$description": "CSS `ease`: cross-fades of artwork and of the room light."
      },
      "linear": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          1,
          1
        ],
        "$description": "Loops: the skeleton, a dwell."
      },
      "ease-in-out": {
        "$type": "cubicBezier",
        "$value": [
          0.42,
          0,
          0.58,
          1
        ],
        "$description": "CSS `ease-in-out`: the ambient loops (breathe, Ken Burns)."
      }
    },
    "press": {
      "duration": {
        "$type": "duration",
        "$value": "180ms",
        "$description": "The press dip. Unchanged under Reduce Motion."
      },
      "curve": {
        "$type": "cubicBezier",
        "$value": "{motion.curve.standard}"
      },
      "scale": {
        "$type": "number",
        "$value": 0.96,
        "$description": "The scale a pressed target dips to."
      }
    },
    "hover": {
      "duration": {
        "$type": "duration",
        "$value": "180ms",
        "$description": "A poster rising under the pointer, and settling back. Instant under Reduce Motion."
      },
      "lift": {
        "$type": "dimension",
        "$value": "2px",
        "$description": "How far a poster rises under the pointer: a mouse or a trackpad, never a finger."
      }
    },
    "standard": {
      "duration": {
        "$type": "duration",
        "$value": "320ms",
        "$description": "State changes, expand, select. Reduce Motion: a 150 ms fade."
      },
      "curve": {
        "$type": "cubicBezier",
        "$value": "{motion.curve.standard}"
      }
    },
    "emphasized": {
      "duration": {
        "$type": "duration",
        "$value": "420ms",
        "$description": "The pager, the segmented thumb, the chip rail. Reduce Motion: a 150 ms fade."
      },
      "curve": {
        "$type": "cubicBezier",
        "$value": "{motion.curve.standard}"
      }
    },
    "enter": {
      "duration": {
        "$type": "duration",
        "$value": "520ms",
        "$description": "An entrance: rise and fade. Reduce Motion: no rise."
      },
      "curve": {
        "$type": "cubicBezier",
        "$value": "{motion.curve.standard}"
      },
      "rise": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "How far an entering element rises."
      },
      "stagger": {
        "$type": "duration",
        "$value": "40ms",
        "$description": "The delay between siblings entering."
      },
      "stagger-max": {
        "$type": "number",
        "$value": 6,
        "$description": "Siblings past this many enter together."
      }
    },
    "sheet-in": {
      "duration": {
        "$type": "duration",
        "$value": "380ms",
        "$description": "Sheets and dialogs in. Reduce Motion: a fade."
      },
      "curve": {
        "$type": "cubicBezier",
        "$value": "{motion.curve.sheet-in}"
      }
    },
    "sheet-out": {
      "duration": {
        "$type": "duration",
        "$value": "240ms",
        "$description": "Sheets and dialogs out. Reduce Motion: a fade."
      },
      "curve": {
        "$type": "cubicBezier",
        "$value": "{motion.curve.sheet-out}"
      }
    },
    "shared": {
      "duration": {
        "$type": "duration",
        "$value": "450ms",
        "$description": "The poster → Media flight. Reduce Motion: a cross-fade."
      },
      "curve": {
        "$type": "cubicBezier",
        "$value": "{motion.curve.standard}"
      }
    },
    "progress": {
      "duration": {
        "$type": "duration",
        "$value": "600ms",
        "$description": "A bar moving to a new value. Reduce Motion: a jump."
      },
      "curve": {
        "$type": "cubicBezier",
        "$value": "{motion.curve.standard}"
      }
    },
    "text-xfade": {
      "duration": {
        "$type": "duration",
        "$value": "700ms",
        "$description": "Carousel copy changing, rising 10."
      },
      "curve": {
        "$type": "cubicBezier",
        "$value": "{motion.curve.standard}"
      },
      "rise": {
        "$type": "dimension",
        "$value": "10px",
        "$description": "How far the copy rises as it comes in. Reduce Motion: none."
      }
    },
    "image-xfade": {
      "duration": {
        "$type": "duration",
        "$value": "900ms",
        "$description": "Carousel art changing."
      },
      "curve": {
        "$type": "cubicBezier",
        "$value": "{motion.curve.ease}"
      }
    },
    "roll": {
      "duration": {
        "$type": "duration",
        "$value": "900ms",
        "$description": "A figure rolls once from \"—\" to its value; never counts up from 0. Reduce Motion: the final figure."
      },
      "curve": {
        "$type": "cubicBezier",
        "$value": "{motion.curve.roll}"
      }
    },
    "light": {
      "duration": {
